# ============================================================================
# Puja Platform – Backend API Environment Configuration
# Copy this file to `.env` (`cp .env.example .env`) and adjust as needed.
# All external integrations have built-in local fallbacks out of the box.
# ============================================================================

# Runtime mode: development | test | production
NODE_ENV=development

# HTTP & Socket.io server port
PORT=5000

# MongoDB connection URI (local mongod or MongoDB Atlas SRV string)
MONGO_URI=mongodb://127.0.0.1:27017/puja_platform

# JWT signing secret (MUST be >= 32 random characters in production)
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-min
# Token validity duration (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins for CORS & Socket.io
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081

# ----------------------------------------------------------------------------
# Razorpay Payment Gateway (https://dashboard.razorpay.com/app/keys)
# Leave blank in local development to automatically use Sandbox/Mock mode
# with full HMAC-SHA256 order & signature verification.
# ----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Cloudinary Media Storage (https://console.cloudinary.com)
# Leave blank in local development to automatically store uploaded images
# and KYC PDFs on local disk under `backend/uploads/` served at `/uploads/*`.
# ----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----------------------------------------------------------------------------
# Platform Business Rules
# ----------------------------------------------------------------------------
# Platform commission deducted from gross booking value (0.2 = 20%)
COMMISSION_RATE=0.2
# Minimum advance percentage payable at checkout when choosing "Advance" (30 = 30%)
ADVANCE_PERCENT=30
