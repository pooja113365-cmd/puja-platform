# ============================================================================
# GetPuja – Customer Mobile App (Expo SDK 52) Environment Configuration
# Copy this file to `.env` (`cp .env.example .env`) and replace keys before launch
# ============================================================================

# Base URL of the GetPuja Express REST API:
# - Production:       https://puja-backend-o1wr.onrender.com/api
# - Android Emulator: http://10.0.2.2:5000/api
# - iOS Simulator:    http://localhost:5000/api
# - Physical Device:  http://<YOUR-LAN-IP>:5000/api
EXPO_PUBLIC_API_URL=https://puja-backend-o1wr.onrender.com/api

# Socket.io server URL for real-time booking & pandit assignment tracking
EXPO_PUBLIC_SOCKET_URL=https://puja-backend-o1wr.onrender.com

# Razorpay Public Key ID (rzp_live_... or rzp_test_...)
# Leave blank to use the key returned by the backend (/api/payments/create-order)
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# Customer Support & WhatsApp Helpline Numbers
EXPO_PUBLIC_SUPPORT_PHONE=9858945678
EXPO_PUBLIC_SUPPORT_WHATSAPP=919858945678
EXPO_PUBLIC_APP_NAME=GetPuja
